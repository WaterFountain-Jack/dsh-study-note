{
  "name": "dsh-study-note",
  "version": "0.1.0",
  "description": "Opt-in per-conversation study notes with topic folders and a maintained Markdown index for DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js", "./package.json": "./package.json" },
  "files": ["src", "cordis.patch.yml", "README.md", "README.zh.md", "PUBLISHING.md", "DESIGN.md", "market", "LICENSE"],
  "engines": { "node": ">=22.19" },
  "keywords": ["dsh-plugin", "deepseek", "study-notes", "markdown"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/WaterFountain-Jack/dsh-study-note.git" },
  "homepage": "https://github.com/WaterFountain-Jack/dsh-study-note#readme",
  "bugs": { "url": "https://github.com/WaterFountain-Jack/dsh-study-note/issues" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.8 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8 || 0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:dsh": "node tests/dsh-smoke.mjs",
    "prepack": "npm run check && npm test"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
